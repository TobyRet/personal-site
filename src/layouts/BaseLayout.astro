---
/**
 * The document shell: <html>, <head> and global CSS.
 * The canonical and Open Graph URLs come from `site.url` (set in Astro's config).
 */
import '@/styles/global.css';
import { site } from '@/site.config';
import { type JsonLdNode, siteGraph, toJsonLd } from '@/lib/structuredData';
import { THEME_KEY } from '@/lib/theme';

export interface Props {
  /** Page title. The site name is added after it. */
  title: string;
  description: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
  /** Extra JSON-LD for this page. Every page already describes the site and the person. */
  structuredData?: JsonLdNode[];
}

const {
  title,
  description,
  noindex = false,
  structuredData = [],
} = Astro.props;
// The home page leads with the name and role. Other pages end with the name.
const fullTitle =
  title === site.name
    ? `${site.name} | ${site.jobTitle}`
    : `${title} | ${site.name}`;
const jsonLd = toJsonLd([...siteGraph(site), ...structuredData]);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
// Made by `bun run og-image` from the /og-card/ page.
const shareImage = new URL('/og-default.png', Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name}, technical lead and senior full-stack engineer`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      Applies a saved light or dark choice before the page paints, so there
      is no flash of the other theme. Mirrors src/lib/theme.ts.
    -->
    <script is:inline define:vars={{ key: THEME_KEY }}>
      try {
        const theme = localStorage.getItem(key);
        if (theme === 'light' || theme === 'dark')
          document.documentElement.dataset.theme = theme;
      } catch {
        // Storage unavailable: follow the device.
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <slot />
    {site.analytics.cloudflareToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({
          token: site.analytics.cloudflareToken,
        })}
      />
    )}
  </body>
</html>
