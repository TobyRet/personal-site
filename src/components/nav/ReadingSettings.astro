---
/**
 * The "Aa" reading settings control: text size, reading font and theme.
 * A disclosure, not a modal: the button toggles a panel of three radio groups.
 * Choices apply at once and are remembered in this browser.
 *
 * Plain HTML plus a small script, so pages do not load a UI framework.
 * Without JavaScript the button stays hidden and the site follows the
 * device's own settings.
 */
const groups = [
  {
    key: 'textSize',
    legend: 'Text size',
    choices: [
      { value: 'm', label: 'Default' },
      { value: 'l', label: 'Large' },
      { value: 'xl', label: 'Larger' },
    ],
  },
  {
    key: 'font',
    legend: 'Font',
    choices: [
      { value: 'serif', label: 'Serif' },
      { value: 'sans', label: 'Sans serif' },
    ],
  },
  {
    key: 'theme',
    legend: 'Theme',
    choices: [
      { value: 'system', label: 'Match device' },
      { value: 'light', label: 'Light' },
      { value: 'dark', label: 'Dark' },
    ],
  },
];
---

<reading-settings class="relative hidden font-ui text-ui">
  <button
    type="button"
    aria-expanded="false"
    aria-controls="reading-settings-panel"
    class="cursor-pointer border border-rule px-2 text-text hover:border-control"
  >
    <span aria-hidden="true" class="font-serif">
      Aa
    </span>
    <span class="sr-only">Reading settings</span>
  </button>
  <form
    id="reading-settings-panel"
    hidden
    class="absolute right-0 z-10 mt-2 flex w-notes flex-col gap-4 border border-rule bg-bg p-4"
  >
    {groups.map((group) => (
      <fieldset class="flex flex-col gap-1">
        <legend class="mb-1 font-semibold text-text">{group.legend}</legend>
        {group.choices.map((choice) => (
          <label class="flex cursor-pointer items-center gap-2 text-text">
            <input type="radio" name={group.key} value={choice.value} />
            {choice.label}
          </label>
        ))}
      </fieldset>
    ))}
  </form>
</reading-settings>

<script>
  import {
    applySettings,
    loadSettings,
    parseSettings,
    saveSettings,
  } from '@/lib/readingSettings';

  function browserStorage(): Storage | undefined {
    try {
      return window.localStorage;
    } catch {
      return undefined;
    }
  }

  class ReadingSettingsElement extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      const form = this.querySelector('form');
      if (!button || !form) return;

      this.classList.remove('hidden');

      const settings = loadSettings(browserStorage());
      for (const [name, value] of Object.entries(settings)) {
        const input = form.querySelector<HTMLInputElement>(
          `input[name="${name}"][value="${value}"]`,
        );
        if (input) input.checked = true;
      }

      const setOpen = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        form.hidden = !open;
      };

      button.addEventListener('click', () =>
        setOpen(button.getAttribute('aria-expanded') !== 'true'),
      );

      form.addEventListener('change', () => {
        const data = Object.fromEntries(new FormData(form));
        const next = parseSettings(JSON.stringify(data));
        applySettings(document.documentElement, next);
        saveSettings(browserStorage(), next);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !form.hidden) {
          setOpen(false);
          button.focus();
        }
      });

      document.addEventListener('pointerdown', (event) => {
        if (!form.hidden && !this.contains(event.target as Node)) {
          setOpen(false);
        }
      });
    }
  }

  customElements.define('reading-settings', ReadingSettingsElement);
</script>
