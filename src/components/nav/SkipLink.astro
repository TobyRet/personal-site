---
interface Props {
  /** The id of the main content element. */
  target?: string;
}

const { target = 'main' } = Astro.props;
---

<a
  href={`#${target}`}
  class="sr-only bg-bg px-gutter py-3 font-ui text-ui font-semibold text-link underline focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
>
  Skip to main content
</a>
