---
import Container from '@/components/layout/Container.astro';
import Link from '@/components/ui/Link.astro';
import { site } from '@/site.config';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** The current URL path, used to mark the active nav item. */
  currentPath: string;
}

const { currentPath } = Astro.props;

const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(href);
---

<header class="border-b border-rule font-ui text-ui">
  <Container class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 py-4 md:flex-nowrap md:py-6">
    <Link
      href="/"
      variant="quiet"
      class="font-semibold"
      current={currentPath === '/'}
    >
      {site.name}
    </Link>
    <nav
      aria-label="Main"
      class="order-last w-full md:order-none md:ml-auto md:w-auto"
    >
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {site.nav.map((item) => (
          <li>
            <Link
              href={item.href}
              variant="quiet"
              current={isCurrent(item.href)}
              class={
                isCurrent(item.href)
                  ? 'underline decoration-accent decoration-2'
                  : undefined
              }
            >
              {item.label}
            </Link>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </Container>
</header>
