---
import Container from '@/components/layout/Container.astro';
import Link from '@/components/ui/Link.astro';
import { site } from '@/site.config';

const { availability } = site;

const message =
  availability.status === 'available'
    ? `Available for contract work from ${availability.from}.`
    : availability.status === 'limited'
      ? 'Limited availability.'
      : 'Not available for new work.';
---

<div class="bg-ink text-white">
  <Container class="py-3 text-small">
    <p class="flex gap-3">
      <span
        aria-hidden="true"
        class:list={[
          'mt-1 size-3 shrink-0 border-2',
          availability.status === 'unavailable'
            ? 'border-white'
            : 'border-accent bg-accent',
        ]}
      ></span>
      <span>
        <strong class="font-bold">{message}</strong>
        {availability.note && <span> {availability.note}</span>}
        {availability.status !== 'unavailable' && (
          <>
            {' '}
            <Link href="/contact/" variant="inverse">
              Get in touch
            </Link>
          </>
        )}
      </span>
    </p>
  </Container>
</div>
