---
/** The facts of a case study, as margin notes. */
import MarginNote from '@/components/ui/MarginNote.astro';

interface Props {
  /** One sentence on when this work matches a reader's need. */
  relevantIf: string;
  client: string;
  sector: string;
  /** Your role on the project. */
  position: string;
  /** Display dates, for example "Sep 2025 to Apr 2026". */
  dates: string;
  /** The consultancy or agency the work came through, if any. */
  through?: string | undefined;
  team?: string | undefined;
  /** The key stack, 4 to 6 items. */
  stack: string[];
}

const { relevantIf, client, sector, position, dates, through, team, stack } =
  Astro.props;
---

<MarginNote label="Relevant if you need" tone="accent">
  <p>{relevantIf}</p>
</MarginNote>
<MarginNote label="Client">
  <p>{client}</p>
</MarginNote>
<MarginNote label="Sector">
  <p>{sector}</p>
</MarginNote>
<MarginNote label="Role">
  <p>{position}</p>
</MarginNote>
<MarginNote label="Dates">
  <p>{dates}</p>
</MarginNote>
{through && (
  <MarginNote label="Through">
    <p>{through}</p>
  </MarginNote>
)}
{team && (
  <MarginNote label="Team">
    <p>{team}</p>
  </MarginNote>
)}
<MarginNote label="Key stack">
  <ul>
    {stack.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</MarginNote>
