---
/** The facts of a case study, as margin notes. */
import MarginNote from '@/components/ui/MarginNote.astro';

interface Props {
  client: string;
  sector: string;
  /** Your role on the project. */
  position: string;
  /** Display dates, for example "Sep 2025 to Apr 2026". */
  dates: string;
  stack: string[];
}

const { client, sector, position, dates, stack } = Astro.props;
---

<MarginNote label="Client">
  <p>{client}</p>
</MarginNote>
<MarginNote label="Sector">
  <p>{sector}</p>
</MarginNote>
<MarginNote label="Role">
  <p>{position}</p>
</MarginNote>
<MarginNote label="Dates">
  <p>{dates}</p>
</MarginNote>
<MarginNote label="Stack">
  <p>{stack.join(', ')}</p>
</MarginNote>
