---
/** The facts of a case study, as margin notes. */
import Link from '@/components/ui/Link.astro';
import MarginNote from '@/components/ui/MarginNote.astro';

interface Props {
  /** One sentence on when this work matches a reader's need. */
  relevantIf: string;
  client: string;
  /** The client's website, opened in a new tab. */
  clientHref?: string | undefined;
  sector: string;
  /** Your role on the project. */
  position: string;
  /** Display dates, for example "Sep 2025 to Apr 2026". */
  dates: string;
  /** The consultancy or agency the work came through, if any. */
  through?: string | undefined;
  team?: string | undefined;
  /** The key stack, 4 to 6 items. */
  stack: string[];
}

const {
  relevantIf,
  client,
  clientHref,
  sector,
  position,
  dates,
  through,
  team,
  stack,
} = Astro.props;
---

<MarginNote label="Relevant if you need" tone="accent">
  <p>{relevantIf}</p>
</MarginNote>
<MarginNote label="Client">
  <p>
    {clientHref ? (
      <Link href={clientHref} target="_blank" rel="external noopener">
        {client}
        <span class="sr-only"> (opens in a new tab)</span>
      </Link>
    ) : (
      client
    )}
  </p>
</MarginNote>
<MarginNote label="Sector">
  <p>{sector}</p>
</MarginNote>
<MarginNote label="Role">
  <p>{position}</p>
</MarginNote>
<MarginNote label="Dates">
  <p>{dates}</p>
</MarginNote>
{through && (
  <MarginNote label="Through">
    <p>{through}</p>
  </MarginNote>
)}
{team && (
  <MarginNote label="Team">
    <p>{team}</p>
  </MarginNote>
)}
<MarginNote label="Key stack">
  <p>{stack.join(', ')}</p>
</MarginNote>
