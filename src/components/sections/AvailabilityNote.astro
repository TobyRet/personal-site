---
import MarginNote from '@/components/ui/MarginNote.astro';
import { site } from '@/site.config';

const { availability } = site;

const message =
  availability.status === 'available'
    ? `Available for contract work from ${availability.from}.`
    : availability.status === 'limited'
      ? 'Limited availability.'
      : 'Not available for new work.';
---

<MarginNote label="Availability" tone="accent">
  <p class="font-semibold">{message}</p>
  {availability.note && <p class="text-text-secondary">{availability.note}</p>}
</MarginNote>
