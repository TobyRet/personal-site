---
import MarginNote from '@/components/ui/MarginNote.astro';
import { availabilityMessage } from '@/lib/availability';
import { site } from '@/site.config';

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
const { availability } = site;
const message = availabilityMessage(availability);
---

<MarginNote label="Availability" tone="accent" class={className}>
  <p class="font-semibold">{message}</p>
  {availability.note && <p class="text-text-secondary">{availability.note}</p>}
</MarginNote>
