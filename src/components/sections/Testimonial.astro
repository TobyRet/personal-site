---
/**
 * The home page quote, set as a pull quote. The credit names the person
 * when known, then their role and organisation, with an optional logo.
 */
import OrgLogo from '@/components/ui/OrgLogo.astro';
import Quote from '@/components/ui/Quote.astro';
import type { Testimonial } from '@/site.config';

interface Props {
  testimonial: Testimonial;
}

const { quote, name, role, organisation, link, logo } = Astro.props.testimonial;

const credit = name || organisation;
const position = name
  ? [role, organisation].filter(Boolean).join(', ')
  : role || undefined;
---

<Quote
  name={credit}
  position={position}
  sourceHref={link}
  sourceLabel="Read the original post on LinkedIn"
  variant="pull"
  class="my-4"
>
  {quote}
  {logo && <OrgLogo slot="mark" logo={logo} />}
</Quote>
