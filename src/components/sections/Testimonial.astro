---
/**
 * The home page quote, credited with the Equal Experts logo.
 * The logo is inline, so it takes the text colour in light and dark mode.
 * It is decorative: the credit text names the organisation.
 */
import EqualExpertsLogo from '@/assets/logos/equal-experts.svg';
import Quote from '@/components/ui/Quote.astro';

interface Props {
  quote: string;
  attribution: string;
  sourceHref: string;
}

const { quote, attribution, sourceHref } = Astro.props;
---

<Quote
  name={attribution}
  sourceHref={sourceHref}
  sourceLabel="Read the original post on LinkedIn"
  variant="pull"
  class="my-4"
>
  {quote}
  <EqualExpertsLogo slot="mark" class="block h-(--size-logo-mark) w-auto" />
</Quote>
