---
/** A margin note with the ways to get in touch. */
import SocialLink from '@/components/ui/SocialLink.astro';
import MarginNote from '@/components/ui/MarginNote.astro';
import { site } from '@/site.config';
---

<MarginNote label="Get in touch">
  <p>
    <SocialLink
      network="linkedin"
      href={site.linkedIn}
      label="Message me on LinkedIn"
    />
  </p>
  <p>
    <SocialLink network="github" href={site.github} label="See my GitHub" />
  </p>
</MarginNote>
