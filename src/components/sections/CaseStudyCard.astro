---
/**
 * One case study in a list: title, a one-line summary and a detail line.
 * The detail line ends with the first three items of the key stack, as plain text.
 */
import Heading from '@/components/ui/Heading.astro';
import Link from '@/components/ui/Link.astro';
import { metaLine } from '@/lib/text';

interface Props {
  title: string;
  href: string;
  summary: string;
  sector: string;
  /** Your role on the project. */
  position: string;
  /** Display dates, for example "2025 to 2026". */
  dates: string;
  /** The key stack. The card shows the first three. */
  stack: string[];
  /** The heading level for the title. Match the page outline. */
  headingLevel?: 2 | 3 | 4;
}

const {
  title,
  href,
  summary,
  sector,
  position,
  dates,
  stack,
  headingLevel = 3,
} = Astro.props;
---

<article class="flex max-w-reading flex-col gap-2 border-t border-rule py-6">
  <Heading level={headingLevel} size="reading">
    <Link href={href}>{title}</Link>
  </Heading>
  <p class="text-reading text-text">{summary}</p>
  <p class="font-ui text-ui text-text-secondary">
    {metaLine([sector, position, dates, stack.slice(0, 3).join(', ')])}
  </p>
</article>
