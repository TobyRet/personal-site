---
/** One case study in a list: title, a one-line summary and a detail line. */
import Heading from '@/components/ui/Heading.astro';
import Link from '@/components/ui/Link.astro';
import Tag from '@/components/ui/Tag.astro';

interface Props {
  title: string;
  href: string;
  summary: string;
  sector: string;
  /** Your role on the project. */
  position: string;
  /** Display dates, for example "2025 to 2026". */
  dates: string;
  /** The key stack, already trimmed to the first three. */
  tags: string[];
  /** The heading level for the title. Match the page outline. */
  headingLevel?: 2 | 3 | 4;
}

const {
  title,
  href,
  summary,
  sector,
  position,
  dates,
  tags,
  headingLevel = 3,
} = Astro.props;
---

<article class="flex max-w-reading flex-col gap-2 border-t border-rule py-6">
  <Heading level={headingLevel} size="reading">
    <Link href={href}>{title}</Link>
  </Heading>
  <p class="text-reading text-text">{summary}</p>
  <p class="font-ui text-ui text-text-secondary">
    {sector}
    <span aria-hidden="true"> · </span>
    <span class="sr-only">, </span>
    {position}
    <span aria-hidden="true"> · </span>
    <span class="sr-only">, </span>
    {dates}
  </p>
  {tags.length > 0 && (
    <ul class="mt-2 flex flex-wrap gap-2" aria-label="Stack">
      {tags.map((tag) => (
        <li>
          <Tag>{tag}</Tag>
        </li>
      ))}
    </ul>
  )}
</article>
