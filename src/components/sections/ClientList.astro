---
/** One line of client names, each linked to its site: "A, B and C". */
import Link from '@/components/ui/Link.astro';
import Text from '@/components/ui/Text.astro';
import { separatorBefore } from '@/lib/text';
import type { Organisation } from '@/site.config';

interface Props {
  clients: Organisation[];
}

const { clients } = Astro.props;
---

{clients.length > 0 && (
  <Text measure>
    <span class="font-semibold">Clients include</span>{' '}
    {clients.map((client, index) => (
      <>
        {separatorBefore(index, clients.length)}
        <Link href={client.href}>{client.name}</Link>
        {index === clients.length - 1 && '.'}
      </>
    ))}
  </Text>
)}
