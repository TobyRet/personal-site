---
/** One line of client names as plain text, in the house style: "A, B and C." */
import Text from '@/components/ui/Text.astro';
import { separatorBefore } from '@/lib/text';

interface Props {
  clients: string[];
}

const { clients } = Astro.props;
const names = clients
  .map((client, index) => separatorBefore(index, clients.length) + client)
  .join('');
---

{clients.length > 0 && (
  <Text measure>
    <span class="font-semibold">Clients include</span> {names}.
  </Text>
)}
