---
/** The "Good fit if you need" heading and its short list. */
import Heading from '@/components/ui/Heading.astro';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby="good-fit" class="flex max-w-reading flex-col gap-4">
    <Heading level={2} id="good-fit">
      Good fit if you need
    </Heading>
    <ul class="flex list-disc flex-col gap-2 pl-6 font-reading text-reading">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
)}
