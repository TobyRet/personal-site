---
/** "I'm a good fit if you need:" and its short list, for the home page hero. */
import Text from '@/components/ui/Text.astro';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="flex max-w-reading flex-col gap-3">
    <Text id="good-fit">I'm a good fit if you need:</Text>
    <ul
      aria-labelledby="good-fit"
      class="flex list-disc flex-col gap-2 pl-6 font-reading text-reading"
    >
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
)}
