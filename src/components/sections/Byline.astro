---
/**
 * The phone byline: a small headshot beside the name and availability,
 * so phones show who this is and when they are free before the title.
 */
import Headshot from '@/components/sections/Headshot.astro';
import { site } from '@/site.config';
---

<div class="flex items-center gap-4 font-ui text-ui" data-testid="byline">
  <Headshot size="byline" />
  <div class="flex flex-col gap-1">
    <p class="font-semibold text-text">{site.name}</p>
    <p class="text-accent">{site.availabilityLine}</p>
  </div>
</div>
