---
/**
 * Availability for phones only. On phones the margin notes fold below the
 * first screen, so this keeps availability in view. Pair it with
 * `<AvailabilityNote class="hidden lg:block" />` so phones see it once.
 */
import { availabilityMessage } from '@/lib/availability';
import { site } from '@/site.config';
---

<div class="flex flex-col gap-1 font-ui text-ui lg:hidden">
  <p class="font-semibold text-accent">
    {availabilityMessage(site.availability)}
  </p>
  {site.availability.note && (
    <p class="text-text-secondary">{site.availability.note}</p>
  )}
</div>
