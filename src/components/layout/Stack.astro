---
import { cx } from '@/lib/cx';

interface Props {
  /** Space between children, from the spacing scale. */
  gap?: 2 | 4 | 6 | 8 | 12 | 16;
  as?: 'div' | 'ul' | 'ol' | 'section' | 'article';
  class?: string | undefined;
}

const { gap = 4, as: Tag = 'div', class: className } = Astro.props;

const gaps = {
  2: 'gap-2',
  4: 'gap-4',
  6: 'gap-6',
  8: 'gap-8',
  12: 'gap-12',
  16: 'gap-16',
} as const;
---

<Tag class={cx('flex flex-col', gaps[gap], className)}>
  <slot />
</Tag>
