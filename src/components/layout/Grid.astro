---
import { cx } from '@/lib/cx';

interface Props {
  /**
   * Column layout from 768px up. Below that, items stack.
   * `two-thirds`: the first child takes two thirds, the second one third.
   */
  layout?: 'two-thirds' | 'halves' | 'thirds';
  gap?: 6 | 8 | 12;
  as?: 'div' | 'ul' | 'ol';
  class?: string | undefined;
}

const {
  layout = 'halves',
  gap = 8,
  as: Tag = 'div',
  class: className,
} = Astro.props;

const layouts = {
  'two-thirds': 'md:grid-cols-3 md:*:first:col-span-2',
  halves: 'md:grid-cols-2',
  thirds: 'md:grid-cols-3',
} as const;

const gaps = {
  6: 'gap-6',
  8: 'gap-8',
  12: 'gap-12',
} as const;
---

<Tag class={cx('grid grid-cols-1', layouts[layout], gaps[gap], className)}>
  <slot />
</Tag>
