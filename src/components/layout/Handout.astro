---
/**
 * The handout layout: a reading column with a margin for notes.
 *
 * Desktop: the title and body sit in the reading column, and the notes sit
 * in the margin to the right, starting level with the title.
 * Phones: the notes fold in under the title, before the body.
 *
 * Slots: `title` (heading and subtitle), `notes` (MarginNote items), default (body).
 */
import { cx } from '@/lib/cx';

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
const hasNotes = Astro.slots.has('notes');
---

<div
  class={cx(
    'grid grid-cols-1 gap-x-12 gap-y-8 py-12 md:py-16',
    hasNotes &&
      'lg:grid-cols-(--layout-handout) lg:grid-rows-(--layout-handout-rows)',
    className,
  )}
>
  <div class="max-w-reading">
    <slot name="title" />
  </div>
  {hasNotes && (
    <aside
      aria-label="Notes"
      class="flex flex-col gap-4 border-t border-rule pt-4 lg:row-span-2 lg:border-t-0 lg:pt-2"
    >
      <slot name="notes" />
    </aside>
  )}
  <div class="max-w-reading">
    <slot />
  </div>
</div>
