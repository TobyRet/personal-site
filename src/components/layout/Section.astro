---
import { cx } from '@/lib/cx';

interface Props {
  /** A 4px ink rule above the section. Use it to open major sections. */
  rule?: boolean;
  spacing?: 'm' | 'l';
  /** The id of the section heading, so screen readers can name the region. */
  labelledBy?: string;
  id?: string;
  class?: string | undefined;
}

const {
  rule = false,
  spacing = 'l',
  labelledBy,
  id,
  class: className,
} = Astro.props;

const spacings = {
  m: 'py-8 md:py-12',
  l: 'py-12 md:py-16',
} as const;
---

<section
  id={id}
  aria-labelledby={labelledBy}
  class={cx(spacings[spacing], className)}
>
  <div class={cx(rule && 'border-t-4 border-rule pt-8 md:pt-12')}>
    <slot />
  </div>
</section>
