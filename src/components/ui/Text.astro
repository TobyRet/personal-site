---
import { cx } from '@/lib/cx';

interface Props {
  /** `reading` for prose. `ui` for interface text, notes and metadata. */
  size?: 'reading' | 'ui';
  tone?: 'default' | 'secondary';
  weight?: 'regular' | 'semibold';
  italic?: boolean;
  /** Limit the line length to the reading measure. */
  measure?: boolean;
  as?: 'p' | 'span' | 'div' | 'strong';
  /** Lets another element point to this text, for example as its label. */
  id?: string | undefined;
  class?: string | undefined;
}

const {
  size = 'reading',
  tone = 'default',
  weight = 'regular',
  italic = false,
  measure = false,
  as: Tag = 'p',
  id,
  class: className,
} = Astro.props;

const sizes = {
  reading: 'font-reading text-reading',
  ui: 'font-ui text-ui',
} as const;
const tones = {
  default: 'text-text',
  secondary: 'text-text-secondary',
} as const;
const weights = { regular: 'font-regular', semibold: 'font-semibold' } as const;
---

<Tag
  id={id}
  class={cx(
    sizes[size],
    tones[tone],
    weights[weight],
    italic && 'italic',
    measure && 'max-w-reading',
    className,
  )}
>
  <slot />
</Tag>
