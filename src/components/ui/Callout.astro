---
/**
 * A note set apart from the reading column: an optional label and an indent.
 * No box and no coloured bar; the indent and label do the work.
 */
import { cx } from '@/lib/cx';

interface Props {
  /** Optional label, for example "Note" or "What I would do differently". */
  title?: string;
  class?: string | undefined;
}

const { title, class: className } = Astro.props;
---

<div class={cx('flex max-w-reading flex-col gap-2 pl-6 md:pl-8', className)}>
  {title && <p class="font-ui text-ui font-semibold text-accent">{title}</p>}
  <div class="flex flex-col gap-4 text-text-secondary">
    <slot />
  </div>
</div>
