---
import { cx } from '@/lib/cx';

interface Props {
  /**
   * `inset`: a grey bar for side notes and asides.
   * `important`: an ink bar for things the reader must not miss.
   */
  variant?: 'inset' | 'important';
  /** Optional bold first line. */
  title?: string;
  class?: string | undefined;
}

const { variant = 'inset', title, class: className } = Astro.props;

const variants = {
  inset: 'border-border',
  important: 'border-rule',
} as const;
---

<div
  class={cx(
    'flex max-w-prose flex-col gap-2 border-l-4 py-2 pl-6',
    variants[variant],
    className,
  )}
>
  {title && <p class="font-bold">{title}</p>}
  <div class="flex flex-col gap-4">
    <slot />
  </div>
</div>
