---
import { cx } from '@/lib/cx';

interface PageLink {
  label: string;
  href: string;
}

interface Props {
  previous?: PageLink | undefined;
  next?: PageLink | undefined;
  /** Names the navigation landmark, for example "Case studies". */
  label: string;
  /** What one item is called, for the link labels: "Next case study". */
  itemName?: string | undefined;
}

const { previous, next, label, itemName } = Astro.props;
const suffix = itemName ? ` ${itemName}` : '';

const linkClass =
  'group flex flex-col gap-1 py-4 text-link no-underline sm:max-w-narrow hover:underline';
---

<nav aria-label={label} class="border-t border-rule font-ui text-ui">
  <ul class="flex flex-col sm:flex-row sm:justify-between sm:gap-8">
    {previous && (
      <li>
        <a
          href={previous.href}
          rel="prev"
          aria-label={`Previous${suffix}: ${previous.label}`}
          class={linkClass}
        >
          <span class="flex items-center gap-2 font-semibold">
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 16 12"
              class="h-3 w-4 fill-none stroke-current stroke-2"
            >
              <path d="M7 1L2 6l5 5M2 6h14" />
            </svg>
            Previous{suffix}
          </span>
          <span class="underline decoration-1 underline-offset-4 group-hover:decoration-2">
            {previous.label}
          </span>
        </a>
      </li>
    )}
    {next && (
      <li class={cx(!previous && 'sm:ml-auto')}>
        <a
          href={next.href}
          rel="next"
          aria-label={`Next${suffix}: ${next.label}`}
          class={cx(linkClass, 'sm:items-end sm:text-right')}
        >
          <span class="flex items-center gap-2 font-semibold">
            Next{suffix}
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 16 12"
              class="h-3 w-4 fill-none stroke-current stroke-2"
            >
              <path d="M9 1l5 5-5 5M14 6H0" />
            </svg>
          </span>
          <span class="underline decoration-1 underline-offset-4 group-hover:decoration-2">
            {next.label}
          </span>
        </a>
      </li>
    )}
  </ul>
</nav>
