---
import { cx } from '@/lib/cx';

interface PageLink {
  label: string;
  href: string;
}

interface Props {
  previous?: PageLink;
  next?: PageLink;
  /** Names the navigation landmark, for example "Case studies". */
  label: string;
}

const { previous, next, label } = Astro.props;

const linkClass =
  'group flex flex-col gap-1 py-4 text-link no-underline sm:max-w-narrow hover:underline';
---

<nav aria-label={label} class="border-t border-border">
  <ul class="flex flex-col sm:flex-row sm:justify-between sm:gap-8">
    {previous && (
      <li>
        <a href={previous.href} rel="prev" class={linkClass}>
          <span class="flex items-center gap-2 font-bold">
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 16 12"
              class="h-3 w-4 fill-none stroke-current stroke-2"
            >
              <path d="M7 1L2 6l5 5M2 6h14" />
            </svg>
            Previous
          </span>
          <span class="underline decoration-1 underline-offset-4 group-hover:decoration-2">
            {previous.label}
          </span>
        </a>
      </li>
    )}
    {next && (
      <li class={cx(!previous && 'sm:ml-auto')}>
        <a
          href={next.href}
          rel="next"
          class={cx(linkClass, 'sm:items-end sm:text-right')}
        >
          <span class="flex items-center gap-2 font-bold">
            Next
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 16 12"
              class="h-3 w-4 fill-none stroke-current stroke-2"
            >
              <path d="M9 1l5 5-5 5M14 6H0" />
            </svg>
          </span>
          <span class="underline decoration-1 underline-offset-4 group-hover:decoration-2">
            {next.label}
          </span>
        </a>
      </li>
    )}
  </ul>
</nav>
