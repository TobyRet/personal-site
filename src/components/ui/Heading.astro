---
import { cx } from '@/lib/cx';

type Size = 'title' | 'heading' | 'reading';

interface Props {
  /** The heading level. Keep levels in order on every page. */
  level: 1 | 2 | 3 | 4;
  /** Visual size. Defaults to the usual size for the level. */
  size?: Size;
  id?: string;
  class?: string | undefined;
}

const { level, size, id, class: className } = Astro.props;

const defaultSize: Record<Props['level'], Size> = {
  1: 'title',
  2: 'heading',
  3: 'reading',
  4: 'reading',
};

const sizes: Record<Size, string> = {
  title: 'text-title font-regular',
  heading: 'text-heading font-semibold',
  reading: 'text-reading font-semibold',
};

const Tag = `h${level}` as const;
---

<Tag
  id={id}
  class={cx(
    'font-reading text-text',
    sizes[size ?? defaultSize[level]],
    className,
  )}
>
  <slot />
</Tag>
