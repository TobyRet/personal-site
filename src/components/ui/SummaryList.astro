---
import { cx } from '@/lib/cx';

export interface SummaryRow {
  key: string;
  value: string | string[];
}

interface Props {
  rows: SummaryRow[];
  class?: string | undefined;
}

const { rows, class: className } = Astro.props;
---

<dl class={cx('font-ui text-ui', className)}>
  {rows.map((row) => (
    <div class="grid grid-cols-1 gap-1 border-b border-rule py-3 sm:grid-cols-3 sm:gap-6">
      <dt class="font-semibold text-text">{row.key}</dt>
      <dd class="text-text-secondary sm:col-span-2">
        {Array.isArray(row.value) ? row.value.join(', ') : row.value}
      </dd>
    </div>
  ))}
</dl>
