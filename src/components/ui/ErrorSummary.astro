---
/**
 * Error summary. Lists every error at the top of the form and links each one
 * to its field. It takes focus when the page loads, so screen reader users
 * hear the problem first.
 */
export interface ErrorItem {
  /** The id of the field with the error, without the leading #. */
  fieldId: string;
  text: string;
}

interface Props {
  errors: ErrorItem[];
  title?: string;
  /** Move focus here on load. Turn it off on pages that only show the pattern. */
  focusOnLoad?: boolean;
}

const {
  errors,
  title = 'There is a problem',
  focusOnLoad = true,
} = Astro.props;
---

{errors.length > 0 && (
  <div
    class="flex max-w-reading flex-col gap-3 border-t-2 border-error pt-4 font-ui text-ui"
    aria-labelledby="error-summary-title"
    role="alert"
    tabindex="-1"
    data-error-summary
  >
    <h2 id="error-summary-title" class="font-semibold text-error">
      {title}
    </h2>
    <ul class="flex flex-col gap-1">
      {errors.map((error) => (
        <li>
          <a
            href={`#${error.fieldId}`}
            class="text-error underline decoration-1 underline-offset-4 hover:decoration-2"
          >
            {error.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

{errors.length > 0 && focusOnLoad && <script is:inline>
  document.querySelector('[data-error-summary]')?.focus();
</script>}
