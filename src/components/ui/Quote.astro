---
/**
 * A quote with its credit. The optional `mark` slot shows a decorative mark,
 * such as an organisation's logo, at the top of the credit.
 */
import { cx } from '@/lib/cx';
import Link from './Link.astro';

interface Props {
  /** Who said it. */
  name: string;
  /** Their role and organisation. */
  position?: string;
  /** Where the quote was first published, if public. */
  sourceHref?: string;
  sourceLabel?: string;
  /** `pull` sets the quote large and italic, with an accent rule on the left. */
  variant?: 'default' | 'pull';
  class?: string | undefined;
}

const {
  name,
  position,
  sourceHref,
  sourceLabel = 'Read the original',
  variant = 'default',
  class: className,
} = Astro.props;
const pull = variant === 'pull';
const hasMark = Astro.slots.has('mark');
---

<figure
  class={cx(
    'flex max-w-reading flex-col gap-4',
    pull && 'gap-6 border-l-2 border-accent pl-6',
    className,
  )}
>
  <blockquote
    class={cx(pull ? 'font-reading text-heading italic' : 'text-reading')}
  >
    <p>
      “<slot />”
    </p>
  </blockquote>
  <figcaption class="flex flex-col font-ui text-ui">
    {hasMark && (
      <span class="mb-2 text-text">
        <slot name="mark" />
      </span>
    )}
    <span class="font-semibold">{name}</span>
    {position && <span class="text-text-secondary">{position}</span>}
    {sourceHref && (
      <span>
        <Link href={sourceHref}>{sourceLabel}</Link>
      </span>
    )}
  </figcaption>
</figure>
