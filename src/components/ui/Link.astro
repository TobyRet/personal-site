---
import type { HTMLAttributes } from 'astro/types';
import { cx } from '@/lib/cx';
import { linkClasses } from './styles';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  /**
   * `default` is the accent ink, always underlined, for links in text.
   * `quiet` is plain ink with an underline on hover, for navigation.
   */
  variant?: keyof typeof linkClasses;
  /** Marks the link as the current page. */
  current?: boolean;
  class?: string | undefined;
}

const {
  href,
  variant = 'default',
  current = false,
  rel,
  class: className,
  ...rest
} = Astro.props;

const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  rel={rel ?? (isExternal ? 'external' : undefined)}
  aria-current={current ? 'page' : undefined}
  class={cx(linkClasses[variant], className)}
  {...rest}
>
  <slot />
</a>
