---
/**
 * Styles rendered Markdown (case studies, page copy) using design tokens only.
 * Use it around `<Content />` from a content collection entry.
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--container-reading);
  }

  .prose :global(> * + *) {
    margin-top: var(--spacing-4);
  }

  .prose :global(h2) {
    margin-top: var(--spacing-12);
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
    font-weight: var(--font-weight-semibold);
  }

  .prose :global(h3) {
    margin-top: var(--spacing-8);
    font-size: var(--text-reading);
    line-height: var(--text-reading--line-height);
    font-weight: var(--font-weight-semibold);
  }

  .prose :global(:is(h2, h3) + *) {
    margin-top: var(--spacing-4);
  }

  .prose :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(ul) {
    padding-left: var(--spacing-6);
    list-style-type: disc;
  }

  .prose :global(ol) {
    padding-left: var(--spacing-6);
    list-style-type: decimal;
  }

  .prose :global(li + li) {
    margin-top: var(--spacing-2);
  }

  .prose :global(a) {
    color: var(--color-link);
    text-decoration-line: underline;
    text-decoration-thickness: var(--border-thin);
    text-underline-offset: var(--underline-offset);
    text-decoration-color: var(--color-link);
  }

  .prose :global(a:hover) {
    text-decoration-thickness: var(--border-medium);
  }

  .prose :global(strong) {
    font-weight: var(--font-weight-semibold);
  }

  .prose :global(code) {
    font-family: var(--font-ui);
    background-color: var(--color-bg-subtle);
    padding-inline: var(--spacing-1);
  }

  .prose :global(blockquote) {
    padding-left: var(--spacing-8);
    font-style: italic;
    color: var(--color-text-secondary);
  }
</style>
