---
import { render } from 'astro:content';
import Handout from '@/components/layout/Handout.astro';
import Page from '@/components/layout/Page.astro';
import ContactNote from '@/components/sections/ContactNote.astro';
import Headshot from '@/components/sections/Headshot.astro';
import PageTitle from '@/components/sections/PageTitle.astro';
import MarginNote from '@/components/ui/MarginNote.astro';
import Prose from '@/components/ui/Prose.astro';
import { getPage } from '@/lib/content';
import { site } from '@/site.config';

const page = await getPage('about');
const { Content } = await render(page);
---

<Page title={page.data.title} description={page.data.description}>
  <Handout>
    <PageTitle
      slot="title"
      title={page.data.title}
      subtitle={page.data.subtitle}
    />
    <Fragment slot="notes">
      <Headshot />
      <MarginNote label="Based in">
        <p>{site.location}</p>
        <p>{site.workingPattern}</p>
      </MarginNote>
      <ContactNote />
    </Fragment>

    <Prose>
      <Content />
    </Prose>
  </Handout>
</Page>
