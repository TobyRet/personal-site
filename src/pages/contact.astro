---
import { render } from 'astro:content';
import Handout from '@/components/layout/Handout.astro';
import Page from '@/components/layout/Page.astro';
import Stack from '@/components/layout/Stack.astro';
import AvailabilityNote from '@/components/sections/AvailabilityNote.astro';
import PageTitle from '@/components/sections/PageTitle.astro';
import Button from '@/components/ui/Button.astro';
import MarginNote from '@/components/ui/MarginNote.astro';
import Prose from '@/components/ui/Prose.astro';
import { getPage } from '@/lib/content';
import { site } from '@/site.config';

const page = await getPage('contact');
const { Content } = await render(page);
---

<Page title={page.data.title} description={page.data.description}>
  <Handout>
    <PageTitle
      slot="title"
      title={page.data.title}
      subtitle={page.data.subtitle}
    />
    <Fragment slot="notes">
      <AvailabilityNote />
      <MarginNote label="Based in">
        <p>{site.location}</p>
        <p>{site.workingPattern}</p>
      </MarginNote>
    </Fragment>

    <Stack gap={8}>
      <Prose>
        <Content />
      </Prose>
      <div>
        <Button href={site.linkedIn}>Message me on LinkedIn</Button>
      </div>
    </Stack>
  </Handout>
</Page>
