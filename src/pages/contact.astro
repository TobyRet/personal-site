---
import { render } from 'astro:content';
import Handout from '@/components/layout/Handout.astro';
import Page from '@/components/layout/Page.astro';
import AvailabilityNote from '@/components/sections/AvailabilityNote.astro';
import PageTitle from '@/components/sections/PageTitle.astro';
import Callout from '@/components/ui/Callout.astro';
import Link from '@/components/ui/Link.astro';
import MarginNote from '@/components/ui/MarginNote.astro';
import Prose from '@/components/ui/Prose.astro';
import { getPage } from '@/lib/content';
import { site } from '@/site.config';

const page = await getPage('contact');
const { Content } = await render(page);
---

<Page title={page.data.title} description={page.data.description}>
  <Handout>
    <PageTitle
      slot="title"
      title={page.data.title}
      subtitle={page.data.subtitle}
    />
    <Fragment slot="notes">
      <AvailabilityNote />
      <MarginNote label="Elsewhere">
        <p>
          <Link href={site.linkedIn}>LinkedIn</Link>
        </p>
      </MarginNote>
    </Fragment>

    <Prose>
      <Content />
    </Prose>

    <!-- TODO: the contact form arrives in phase 4. -->
    <Callout title="Contact form" class="mt-8">
      <p>
        The contact form is not ready yet. For now, message me on
        <Link href={site.linkedIn}>LinkedIn</Link>.
      </p>
    </Callout>
  </Handout>
</Page>
