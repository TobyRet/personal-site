---
/**
 * Internal styleguide. Shows every token and every component variant.
 * Not linked from the site, noindex, and excluded from the sitemap.
 */
import Grid from '@/components/layout/Grid.astro';
import Handout from '@/components/layout/Handout.astro';
import Page from '@/components/layout/Page.astro';
import Section from '@/components/layout/Section.astro';
import Stack from '@/components/layout/Stack.astro';
import Breadcrumbs from '@/components/nav/Breadcrumbs.astro';
import AvailabilityNote from '@/components/sections/AvailabilityNote.astro';
import CaseStudyCard from '@/components/sections/CaseStudyCard.astro';
import CaseStudyFacts from '@/components/sections/CaseStudyFacts.astro';
import Button from '@/components/ui/Button.astro';
import Callout from '@/components/ui/Callout.astro';
import ErrorSummary from '@/components/ui/ErrorSummary.astro';
import Heading from '@/components/ui/Heading.astro';
import Input from '@/components/ui/Input.astro';
import Link from '@/components/ui/Link.astro';
import Pagination from '@/components/ui/Pagination.astro';
import Prose from '@/components/ui/Prose.astro';
import Quote from '@/components/ui/Quote.astro';
import SummaryList from '@/components/ui/SummaryList.astro';
import Tag from '@/components/ui/Tag.astro';
import Text from '@/components/ui/Text.astro';
import Textarea from '@/components/ui/Textarea.astro';

const colours = [
  { name: 'bg', className: 'bg-bg', light: '#ffffff', dark: '#151515' },
  {
    name: 'bg-subtle',
    className: 'bg-bg-subtle',
    light: '#f5f5f3',
    dark: '#1e1e1d',
  },
  { name: 'text', className: 'bg-text', light: '#1a1a1a', dark: '#e8e6e1' },
  {
    name: 'text-secondary',
    className: 'bg-text-secondary',
    light: '#5e5e5e',
    dark: '#a8a6a1',
  },
  { name: 'accent', className: 'bg-accent', light: '#1d3a6b', dark: '#9fbbe8' },
  { name: 'rule', className: 'bg-rule', light: '#d8d8d4', dark: '#3a3a38' },
  {
    name: 'control',
    className: 'bg-control',
    light: '#767676',
    dark: '#8a8a87',
  },
  { name: 'error', className: 'bg-error', light: '#a3262a', dark: '#f08a8a' },
  {
    name: 'success',
    className: 'bg-success',
    light: '#1e6b45',
    dark: '#7cc79d',
  },
];

const typeRoles = [
  {
    name: 'title',
    className: 'font-reading text-title',
    sample: 'I steady projects and still write the code',
  },
  {
    name: 'heading',
    className: 'font-reading text-heading font-semibold',
    sample: 'The situation',
  },
  {
    name: 'reading',
    className: 'font-reading text-reading',
    sample:
      'A calm column for long reading, set at about 65 characters a line.',
  },
  {
    name: 'reading italic',
    className: 'font-reading text-reading italic',
    sample: 'One month of cover became five.',
  },
  {
    name: 'ui',
    className: 'font-ui text-ui',
    sample: 'Navigation, labels, notes and forms',
  },
];

// Literal class names, so Tailwind can find them when it scans this file.
const spacingClasses = {
  1: 'w-1',
  2: 'w-2',
  3: 'w-3',
  4: 'w-4',
  6: 'w-6',
  8: 'w-8',
  12: 'w-12',
  16: 'w-16',
  24: 'w-24',
  32: 'w-32',
} as const;

const spacing = Object.entries(spacingClasses).map(([key, className]) => ({
  key,
  className,
  size: `${Number(key) * 4}px`,
}));

const sample = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.';
---

<Page
  title="Styleguide"
  description="Design tokens and components for this site."
  noindex
>
  <Handout>
    <Fragment slot="title">
      <Heading level={1}>Styleguide</Heading>
      <Text italic tone="secondary" class="mt-2">
        Every token and component on the site. Use the Aa control to try the
        reader settings.
      </Text>
    </Fragment>
    <Fragment slot="notes">
      <AvailabilityNote />
      <CaseStudyFacts
        relevantIf="Lorem ipsum dolor sit amet."
        stack={['Lorem', 'Ipsum', 'Dolor', 'Sit']}
        team="Lorem team"
        client="Lorem ipsum"
        sector="Dolor sit"
        position="Technical lead"
        dates="2025 to 2026"
        through="Lorem Consulting"
      />
    </Fragment>
    <Text>
      This page is itself a handout: the reading column on the left, notes in
      the margin on the right. On phones the notes fold in under the title.
    </Text>
  </Handout>

  <Section rule labelledBy="colour">
    <Stack gap={8}>
      <Heading level={2} id="colour">
        Colour
      </Heading>
      <Text size="ui" tone="secondary">
        Values are light / dark. The swatches follow the current theme.
      </Text>
      <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
        {colours.map((colour) => (
          <li class="flex flex-col gap-2 font-ui text-ui">
            <span class={`block h-12 border border-rule ${colour.className}`} />
            <span class="font-semibold">{colour.name}</span>
            <span class="text-text-secondary">
              {colour.light} / {colour.dark}
            </span>
          </li>
        ))}
      </ul>
    </Stack>
  </Section>

  <Section rule labelledBy="type">
    <Stack gap={8}>
      <Heading level={2} id="type">
        Typography
      </Heading>
      <Text measure>
        Literata for reading and headings. Atkinson Hyperlegible Next for the
        interface. Four roles, each scaled by the reader's text size setting.
      </Text>
      <Stack gap={6}>
        {typeRoles.map((role) => (
          <div class="flex flex-col gap-1 border-b border-rule pb-4">
            <span class="font-ui text-ui text-text-secondary">{role.name}</span>
            <span class={role.className}>{role.sample}</span>
          </div>
        ))}
      </Stack>
    </Stack>
  </Section>

  <Section rule labelledBy="spacing">
    <Stack gap={8}>
      <Heading level={2} id="spacing">
        Spacing
      </Heading>
      <ul class="flex flex-col gap-2 font-ui text-ui">
        {spacing.map((step) => (
          <li class="flex items-center gap-4">
            <span class="w-12">{step.key}</span>
            <span class={`block h-4 bg-text ${step.className}`} />
            <span class="text-text-secondary">{step.size}</span>
          </li>
        ))}
      </ul>
    </Stack>
  </Section>

  <Section rule labelledBy="links">
    <Stack gap={8}>
      <Heading level={2} id="links">
        Links and buttons
      </Heading>
      <p class="flex flex-wrap gap-6">
        <Link href="#links">Link in text</Link>
        <Link href="#links" variant="quiet">
          Quiet link
        </Link>
      </p>
      <div class="flex flex-wrap gap-4">
        <Button>Primary button</Button>
        <Button variant="secondary">Secondary button</Button>
        <Button href="#links">Link as button</Button>
        <Button disabled>Disabled</Button>
      </div>
      <Text size="ui" tone="secondary">
        Tab through this section to see focus styles.
      </Text>
    </Stack>
  </Section>

  <Section rule labelledBy="content">
    <Stack gap={12}>
      <Heading level={2} id="content">
        Content
      </Heading>
      <Stack gap={4}>
        <Heading level={3}>Tags</Heading>
        <div class="flex flex-wrap gap-2">
          <Tag>TypeScript</Tag>
          <Tag>React</Tag>
          <Tag>Laravel</Tag>
        </div>
      </Stack>
      <Stack gap={4}>
        <Heading level={3}>Callout</Heading>
        <Callout title="Note">
          <p>{sample}</p>
        </Callout>
      </Stack>
      <Stack gap={4}>
        <Heading level={3}>Summary list</Heading>
        <SummaryList
          rows={[
            { key: 'Sector', value: 'Lorem ipsum' },
            { key: 'Role', value: 'Lorem ipsum dolor' },
            { key: 'Stack', value: ['TypeScript', 'React', 'Node.js'] },
          ]}
          class="max-w-reading"
        />
      </Stack>
      <Stack gap={4}>
        <Heading level={3}>Quote</Heading>
        <Quote name="Lorem Ipsum" position="Dolor sit, Amet Consulting">
          {sample}
        </Quote>
      </Stack>
      <Stack gap={4}>
        <Heading level={3}>Case study list</Heading>
        <div>
          <CaseStudyCard
            title="Lorem ipsum dolor sit amet"
            href="#content"
            summary={sample}
            sector="Dolor"
            position="Technical lead"
            dates="2025 to 2026"
            tags={['Lorem', 'Ipsum', 'Dolor']}
            headingLevel={4}
          />
          <CaseStudyCard
            title="Consectetur adipiscing elit sed do"
            href="#content"
            summary={sample}
            sector="Dolor"
            position="Senior engineer"
            dates="2024"
            tags={['Lorem', 'Ipsum', 'Dolor']}
            headingLevel={4}
          />
        </div>
      </Stack>
      <Stack gap={4}>
        <Heading level={3}>Prose</Heading>
        <Prose>
          <p>
            {sample} <a href="#content">An inline link</a> and{' '}
            <code>inline code</code>.
          </p>
          <h2>Prose heading level 2</h2>
          <p>{sample}</p>
          <ul>
            <li>First item</li>
            <li>Second item</li>
          </ul>
          <h3>Prose heading level 3</h3>
          <ol>
            <li>First step</li>
            <li>Second step</li>
          </ol>
          <blockquote>
            <p>{sample}</p>
          </blockquote>
        </Prose>
      </Stack>
    </Stack>
  </Section>

  <Section rule labelledBy="navigation">
    <Stack gap={8}>
      <Heading level={2} id="navigation">
        Navigation
      </Heading>
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Work', href: '#navigation' },
          { label: 'Lorem ipsum' },
        ]}
      />
      <Pagination
        label="Example pagination"
        previous={{ label: 'Lorem ipsum dolor', href: '#navigation' }}
        next={{ label: 'Sit amet consectetur', href: '#navigation' }}
      />
    </Stack>
  </Section>

  <Section rule labelledBy="forms">
    <Stack gap={8}>
      <Heading level={2} id="forms">
        Forms
      </Heading>
      <ErrorSummary
        focusOnLoad={false}
        errors={[
          {
            fieldId: 'sg-email-error',
            text: 'Enter an email address in the correct format',
          },
        ]}
      />
      <Grid layout="halves">
        <div class="flex flex-col gap-6">
          <Input id="sg-name" name="name" label="Name" autocomplete="name" />
          <Input
            id="sg-company"
            name="company"
            label="Company"
            labelSuffix="(optional)"
            hint="The organisation you work for."
          />
          <Input
            id="sg-email-error"
            name="email"
            type="email"
            label="Email address"
            value="not-an-email"
            error="Enter an email address in the correct format, like name@example.com"
          />
          <Textarea
            id="sg-message"
            name="message"
            label="Message"
            hint="Lorem ipsum dolor sit amet."
          />
          <div>
            <Button type="button">Send message</Button>
          </div>
        </div>
      </Grid>
    </Stack>
  </Section>
</Page>
