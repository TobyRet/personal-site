---
import Handout from '@/components/layout/Handout.astro';
import Page from '@/components/layout/Page.astro';
import Stack from '@/components/layout/Stack.astro';
import AvailabilityNote from '@/components/sections/AvailabilityNote.astro';
import Byline from '@/components/sections/Byline.astro';
import CaseStudyCard from '@/components/sections/CaseStudyCard.astro';
import ClientList from '@/components/sections/ClientList.astro';
import GoodFitList from '@/components/sections/GoodFitList.astro';
import Headshot from '@/components/sections/Headshot.astro';
import PageTitle from '@/components/sections/PageTitle.astro';
import Testimonial from '@/components/sections/Testimonial.astro';
import ThroughList from '@/components/sections/ThroughList.astro';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Link from '@/components/ui/Link.astro';
import MarginNote from '@/components/ui/MarginNote.astro';
import Text from '@/components/ui/Text.astro';
import { caseStudyHref, getFeaturedCaseStudies, getPage } from '@/lib/content';
import { formatYears } from '@/lib/dates';
import { site } from '@/site.config';

const page = await getPage('home');
const featured = await getFeaturedCaseStudies();
const { goodFit = [] } = page.data;
---

<Page title={site.name} description={page.data.description}>
  <Handout notesFrom="lg" stickyNotes>
    <Byline slot="byline" />
    <PageTitle
      slot="title"
      title={page.data.title}
      subtitle={page.data.subtitle}
    />
    <Stack slot="lead" gap={6}>
      <GoodFitList items={goodFit} />
      <div>
        <Button href={site.contactHref}>Message me on LinkedIn</Button>
      </div>
    </Stack>
    <Fragment slot="notes">
      <Headshot />
      <AvailabilityNote />
      <MarginNote label="Based in">
        <p>{site.location}</p>
        <p>{site.workingPattern}</p>
      </MarginNote>
    </Fragment>

    <Stack gap={12}>
      {site.testimonial.show && <Testimonial testimonial={site.testimonial} />}
      <Stack gap={6}>
        <ClientList clients={site.clients} />
        <ThroughList consultancies={site.through} />
      </Stack>

      <section aria-labelledby="selected-work">
        <Heading level={2} id="selected-work" class="mb-2">
          Selected work
        </Heading>
        {featured.map((entry) => (
          <CaseStudyCard
            title={entry.data.title}
            href={caseStudyHref(entry)}
            summary={entry.data.summary}
            sector={entry.data.sector}
            position={entry.data.role}
            dates={formatYears(entry.data.start, entry.data.end)}
            stack={entry.data.stack}
          />
        ))}
        <p class="border-t border-rule pt-6 font-ui text-ui">
          <Link href="/work/">All case studies</Link>
        </p>
      </section>

      <section aria-labelledby="work-with-me" class="flex flex-col gap-4">
        <Heading level={2} id="work-with-me">
          Work with me
        </Heading>
        <Text>
          Tell me about your project and when you need someone. I take on
          hands-on lead, senior engineer and cover roles.
        </Text>
        {site.availability.note && (
          <Text class="lg:hidden">{site.availability.note}</Text>
        )}
        <div>
          <Button href={site.contactHref}>Message me on LinkedIn</Button>
        </div>
      </section>
    </Stack>
  </Handout>
</Page>
