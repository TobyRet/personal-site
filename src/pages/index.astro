---
import Handout from '@/components/layout/Handout.astro';
import Page from '@/components/layout/Page.astro';
import AvailabilityNote from '@/components/sections/AvailabilityNote.astro';
import Heading from '@/components/ui/Heading.astro';
import MarginNote from '@/components/ui/MarginNote.astro';
import Text from '@/components/ui/Text.astro';
import { site } from '@/site.config';
---

<Page title={site.name} description={`${site.name}, ${site.jobTitle}.`}>
  <!-- TODO: replace with the real home page in phase 3. -->
  <Handout>
    <Fragment slot="title">
      <Heading level={1}>{site.name}</Heading>
      <Text italic tone="secondary" class="mt-2">
        {site.jobTitle}
      </Text>
    </Fragment>
    <Fragment slot="notes">
      <AvailabilityNote />
      <MarginNote label="Based in">
        <p>{site.location}</p>
        <p>{site.workingPattern}</p>
      </MarginNote>
    </Fragment>
    <Text>Site setup in progress.</Text>
  </Handout>
</Page>
