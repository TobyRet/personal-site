---
import Page from '@/components/layout/Page.astro';
import Section from '@/components/layout/Section.astro';
import Stack from '@/components/layout/Stack.astro';
import Heading from '@/components/ui/Heading.astro';
import Text from '@/components/ui/Text.astro';
import { site } from '@/site.config';
---

<Page title={site.name} description={`${site.name}, ${site.jobTitle}.`}>
  <!-- TODO: replace with the real home page in phase 3. -->
  <Section>
    <Stack gap={6}>
      <Heading level={1} size="display">
        {site.name}
      </Heading>
      <Text size="lead" measure>
        Site setup in progress.
      </Text>
    </Stack>
  </Section>
</Page>
